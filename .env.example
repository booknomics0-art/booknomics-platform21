# ============================================================================
# Booknomics — Environment configuration template
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file (see .gitignore). Sensitive values here are examples only.
#
# Supabase:
#   VITE_*  -> public / browser-safe (anon key is meant to be exposed)
#   SUPABASE_SERVICE_ROLE_KEY / RAZORPAY_KEY_SECRET / GEMINI_API_KEY / XAI_API_KEY
#   -> SECRET. Must stay server-side (Supabase Edge Function secrets) only.

# ---------------------------------------------------------------- Supabase (client)
# Used by the browser via `import.meta.env.VITE_*`.
VITE_SUPABASE_PROJECT_ID="pbkfewrtdgiagytmcigb"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_0xHTLlIf-4yj0yxVcnEWfQ_C02UtgVO"
VITE_SUPABASE_URL="https://pbkfewrtdgiagytmcigb.supabase.co"

# ---------------------------------------------------------------- Supabase (edge functions)
# Injected automatically by Supabase at runtime (Deno.env). Listed here for
# completeness; you normally set these in the Supabase dashboard, not .env.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------ CORS / security
# Comma-separated list of allowed browser origins for the edge functions.
# Production: https://booknomics.com  (include http://localhost:<port> for local dev).
CORS_ALLOWED_ORIGINS="https://booknomics.com"

# ----------------------------------------------------------------------- Payments
# Must start with rzp_test_ (test) or rzp_live_ (live). KEEP SECRET.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Same account + same mode as RAZORPAY_KEY_ID.

# --------------------------------------------------------------------- AI / content
# Used by generate-book-content / generate-book-modules / polish-book-content /
# translate-to-hindi / seo-marketing / generate-action-plan / generate-expert-perspective
GEMINI_API_KEY=""
# Used by generate-book-cover
XAI_API_KEY=""
# Used by book-audio (TTS)
ELEVENLABS_API_KEY=""

# ------------------------------------------------------- Google / n8n / Lovable
# Used by admin-gsc (Lovable connector gateway for Google Search Console)
LOVABLE_API_KEY=""
GOOGLE_SEARCH_CONSOLE_API_KEY=""
# Used by welcome-email / dispatch-n8n webhook dispatcher
N8N_WELCOME_WEBHOOK_URL=""

# Fail production builds if fewer than the expected migrated books are returned.
SITEMAP_MIN_BOOKS="0"
# Local/CI compilation only. NEVER enable for production.
ALLOW_STATIC_SITEMAP="false"
