# Pinterest API v5 access token (OAuth 2.0, scopes: boards:read, pins:read, boards:write, pins:write)
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_BASE=https://api.pinterest.com/v5

# Safety switch — keep false until the endpoint is secured and tested
ENABLE_PINTEREST_WRITES=false

# Optional: require this value as "Authorization: Bearer <secret>" or "x-mcp-secret: <secret>"
MCP_SHARED_SECRET=
