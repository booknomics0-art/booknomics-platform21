{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "booknomics",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BOOKNOMICS_ENV": "migration"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booknomics-production",
      "database_id": "b4774bd2-a463-4115-bc32-fb32119332e8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOK_COVERS",
      "bucket_name": "booknomics-covers"
    },
    {
      "binding": "BOOK_ASSETS",
      "bucket_name": "booknomics-assets"
    }
  ]
}
