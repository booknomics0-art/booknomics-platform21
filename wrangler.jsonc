{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "booknomics",
  "main": "worker/securityEntry.ts",
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "booknomics.com/*",
      "zone_name": "booknomics.com"
    },
    {
      "pattern": "www.booknomics.com/*",
      "zone_name": "booknomics.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/media/*",
      "/oauth/*",
      "/.well-known/*",
      "/mcp"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BOOKNOMICS_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booknomics-production",
      "database_id": "b4774bd2-a463-4115-bc32-fb32119332e8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOK_COVERS",
      "bucket_name": "booknomics-covers"
    },
    {
      "binding": "BOOK_ASSETS",
      "bucket_name": "booknomics-assets"
    }
  ],
  "previews": {
    "vars": {
      "BOOKNOMICS_ENV": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "booknomics-staging",
        "database_id": "0eafec3d-9329-4dd3-aef7-e2a9e2117f30"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BOOK_COVERS",
        "bucket_name": "booknomics-staging-covers"
      },
      {
        "binding": "BOOK_ASSETS",
        "bucket_name": "booknomics-staging-assets"
      }
    ]
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "BOOKNOMICS_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "booknomics-staging",
          "database_id": "0eafec3d-9329-4dd3-aef7-e2a9e2117f30"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BOOK_COVERS",
          "bucket_name": "booknomics-staging-covers"
        },
        {
          "binding": "BOOK_ASSETS",
          "bucket_name": "booknomics-staging-assets"
        }
      ]
    }
  }
}
